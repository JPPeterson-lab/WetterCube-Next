# WetterCube Next: ESP32 CYD (ESP32-2432S028, 4 MB Flash, kein PSRAM)
CONFIG_IDF_TARGET="esp32"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LV_CONF_SKIP=n
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
# Webserver: laengere Kopfzeilen und URLs
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
# Rollback: eine neue Firmware gilt erst nach gesundem Start als gueltig
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# SNTP: drei Zeitserver
CONFIG_LWIP_SNTP_MAX_SERVERS=3
# Speicher sparen (kein BLE, kleinere WLAN-Puffer)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
